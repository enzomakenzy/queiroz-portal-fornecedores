# 1. API & APPLICATION SETTINGS
# Port exposed by the NestJS API container on your host machine
PORT=3000

# 2. POSTGRESQL CONTAINER SETTINGS
# Credentials and database name initialized by the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fornecedores_queiroz_db

# Host port mapped to container's 5432 (5433 avoids conflict with local Postgres)
POSTGRES_PORT=5433

# 3. TOKEN JWT
# Secret key used to sign and verify JWT authentication tokens (HS256)
JWT_SECRET=6ea17fa8418e81725324910a31e394af757d6b5210c1f9e976b3ec3721743a64

# 4. PRISMA DATABASE CONNECTION (DATABASE_URL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>?schema=public

# - For local dev (.env): use "@localhost:5433" (connects via host mapped port)
# - For full Docker (.env.production): use "@postgres:5432" (internal Docker network)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/fornecedores_queiroz_db?schema=public"