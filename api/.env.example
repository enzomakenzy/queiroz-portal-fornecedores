# 1. SERVER CONFIGURATION
# Port where the NestJS server will listen locally (npm run start:dev)
PORT=3000

# 2. Prisma query and engine log level.
# Options: "query" (logs raw SQL queries), "info", "warn", "error" (default)
PRISMA_LOG="query"

# 3. TOKEN JWT
# Secret key used to sign and verify JWT authentication tokens (HS256)
JWT_SECRET=6ea17fa8418e81725324910a31e394af757d6b5210c1f9e976b3ec3721743a64

# 4. DATABASE CONNECTION (PRISMA)
# Connects to the PostgreSQL container running on localhost:5433 (docker:dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fornecedores_queiroz_db?schema=public"